{
  "name": "pawang-masuk-apoteker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "supabase:network": "node scripts/ensure-supabase-local-network.mjs",
    "supabase:start": "npm run supabase:network && npx supabase start --network-id supabase-localhost --ignore-health-check -x vector",
    "supabase:functions:serve": "node scripts/serve-supabase-functions.mjs",
    "supabase:functions:serve:qg": "node scripts/serve-supabase-functions.mjs question-generator",
    "supabase:reset": "node scripts/reset-supabase-local.mjs",
    "supabase:status": "docker ps --filter name=supabase_ --format \"table {{.Names}}\t{{.Status}}\t{{.Ports}}\"",
    "supabase:stop": "npx supabase stop --all --no-backup"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.7.1",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/supabase-js": "^2.105.1",
    "@tanstack/react-query": "^5.100.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.84.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
